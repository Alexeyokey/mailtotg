# Пароли приложений, не основной пароль почты. Значения можно заключать в 'кавычки'.
MAIL_1_PASSWORD=
MAIL_2_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Для OpenAI: model в соответствии с доступом вашего API-аккаунта.
# Для Ollama: имя установленной у вас модели.
SUMMARY_MODEL=
SUMMARY_API_KEY=
# OpenAI: https://api.openai.com/v1; Ollama: http://127.0.0.1:11434
SUMMARY_API_URL=

# Явные отдельные HTTP/HTTPS/SOCKS5 прокси; пусто = прямое соединение.
# Пример: socks5://user:password@proxy.example.org:1080
# Это не отменяет маршруты системного VPN и не проксирует IMAP.
TELEGRAM_PROXY_URL=
SUMMARY_PROXY_URL=
