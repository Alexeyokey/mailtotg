[Unit]
Description=IMAP Telegram summary bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mailbot
Group=mailbot
WorkingDirectory=/opt/mail-summary-bot
EnvironmentFile=/etc/mail-summary-bot/credentials.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mail-summary-bot/.venv/bin/mail-summary-bot run --config /etc/mail-summary-bot/config.toml --env /dev/null
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=mail-summary-bot
StateDirectoryMode=0700
ReadWritePaths=/var/lib/mail-summary-bot

[Install]
WantedBy=multi-user.target
