[Unit]
Description=Two-mailbox Telegram summary bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mailbot
Group=mailbot
WorkingDirectory=/opt/mail-summary-bot
ExecStart=/opt/mail-summary-bot/.venv/bin/mail-summary-bot run --config /opt/mail-summary-bot/config.toml --env /opt/mail-summary-bot/.env
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mail-summary-bot/data

[Install]
WantedBy=multi-user.target
